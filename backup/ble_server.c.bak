#include "esp_bt.h"
#include "esp_gap_ble_api.h"
#include "esp_gatts_api.h"
#include "esp_bt_main.h"
#include "esp_gatt_common_api.h"
#include "esp_log.h"

static const char *TAG_BLE = "BLE_SERVER";

/* UUID-uri simple pentru test */
#define THERMAL_SERVICE_UUID  0xFFE0

/* Handle pentru serviciu */
static uint16_t thermal_service_handle = 0;

/* Advertising data */
static esp_ble_adv_params_t adv_params = {
    .adv_int_min        = 0x20,
    .adv_int_max        = 0x40,
    .adv_type           = ADV_TYPE_IND,
    .own_addr_type      = BLE_ADDR_TYPE_PUBLIC,
    .channel_map        = ADV_CHNL_ALL,
    .adv_filter_policy  = ADV_FILTER_ALLOW_SCAN_ANY_CON_ANY,
};

/* GAP event handler */
static void gap_event_handler(esp_gap_ble_cb_event_t event,
                              esp_ble_gap_cb_param_t *param)
{
    switch (event) {
        case ESP_GAP_BLE_ADV_START_COMPLETE_EVT:
            ESP_LOGI(TAG_BLE, "Advertising started");
            break;

        default:
            break;
    }
}

/* GATT Server event handler */
static void gatts_event_handler(esp_gatts_cb_event_t event,
                                esp_gatt_if_t gatts_if,
                                esp_ble_gatts_cb_param_t *param)
{
    switch (event) {

        case ESP_GATTS_REG_EVT:
            ESP_LOGI(TAG_BLE, "GATT server registered");

            /* Setăm numele device-ului */
            esp_ble_gap_set_device_name("ThermalNode-1");

            /* Creăm serviciul nostru */
            esp_ble_gatts_create_service(gatts_if,
                                         &(esp_gatt_srvc_id_t){
                                             .is_primary = true,
                                             .id = {
                                                 .uuid = {
                                                     .len = ESP_UUID_LEN_16,
                                                     .uuid = {.uuid16 = THERMAL_SERVICE_UUID}
                                                 },
                                                 .inst_id = 0
                                             }
                                         },
                                         6 /* număr handle-uri alocate */);
            break;

        case ESP_GATTS_CREATE_EVT:
            thermal_service_handle = param->create.service_handle;
            ESP_LOGI(TAG_BLE, "Service created, handle=%d", thermal_service_handle);

            /* Începem advertising */
            esp_ble_gap_start_advertising(&adv_params);
            break;

        default:
            break;
    }
}

void ble_server_init()
{
    ESP_LOGI(TAG_BLE, "Initializing BLE Server...");

    esp_bt_controller_config_t bt_cfg = BT_CONTROLLER_INIT_CONFIG_DEFAULT();
    ESP_ERROR_CHECK( esp_bt_controller_init(&bt_cfg) );
    ESP_ERROR_CHECK( esp_bt_controller_enable(ESP_BT_MODE_BLE) );
    ESP_ERROR_CHECK( esp_bluedroid_init() );
    ESP_ERROR_CHECK( esp_bluedroid_enable() );

    ESP_ERROR_CHECK( esp_ble_gap_register_callback(gap_event_handler) );
    ESP_ERROR_CHECK( esp_ble_gatts_register_callback(gatts_event_handler) );

    /* Înregistrăm aplicația GATT */
    ESP_ERROR_CHECK( esp_ble_gatts_app_register(0x55) );

    ESP_LOGI(TAG_BLE, "BLE Server init complete");
}
